# Public site origin — used for canonical URLs, sitemap, OG tags and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://mabeladeteye.com

# Web3Forms access key for the Bookings & Enquiries form.
# Get one free at https://web3forms.com — enter the address that should receive
# enquiries and the key arrives by email. Free tier: 250 submissions/month.
#
# This key is public by design: it only authorises posting to this one form and
# Web3Forms rate-limits it server side. Without it the form falls back to opening
# the visitor's mail client.
NEXT_PUBLIC_WEB3FORMS_KEY=
